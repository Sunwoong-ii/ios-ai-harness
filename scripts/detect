#!/usr/bin/env bash
# 프로젝트를 훑어 .harness/project.json 초안을 만든다. 하네스를 설치할 때 쓰는 도구다.
# 스펙: docs/project-config.md
set -euo pipefail

usage() {
  cat <<'EOF'
사용법: scripts/detect [--write [--force]] [프로젝트 경로]

  프로젝트 경로를 생략하면 현재 디렉터리가 속한 git 저장소의 루트를 본다.
  초안 JSON은 stdout으로, 판단 근거와 경고는 stderr로 출력한다.
  --write   <프로젝트>/.harness/project.json에 저장한다
  --force   --write일 때 기존 파일을 덮어쓴다

환경 변수:
  HARNESS_OFFLINE=1       xcodebuild·simctl을 부르지 않고 파일만 본다 (테스트용)
  HARNESS_SIMULATOR=이름   시뮬레이터 이름을 직접 지정한다
EOF
}

write_to_file=0        # --write: 초안을 파일로 저장한다 (0 또는 1)
overwrite_existing=0   # --force: 이미 있는 설정 파일을 덮어쓴다 (0 또는 1)
project_dir=""         # 설정 파일 초안을 만들 iOS 프로젝트의 루트

while [ $# -gt 0 ]; do
  case "$1" in
    --write)
      write_to_file=1
      ;;
    --force)
      overwrite_existing=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "detect: 알 수 없는 옵션: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      project_dir="$1"
      ;;
  esac
  shift
done

if ! command -v jq > /dev/null 2>&1; then
  echo "detect: jq가 필요합니다 (macOS에는 /usr/bin/jq로 기본 포함)" >&2
  exit 1
fi

if [ -z "$project_dir" ]; then
  project_dir="$(git rev-parse --show-toplevel 2> /dev/null || pwd)"
fi
if [ ! -d "$project_dir" ]; then
  echo "detect: 디렉터리가 없습니다: $project_dir" >&2
  exit 1
fi
project_dir="$(cd "$project_dir" && pwd)"   # 절대 경로로 바꾼다 (예: /Users/me/MotoTrace)
offline="${HARNESS_OFFLINE:-0}"             # 1이면 xcodebuild·simctl을 부르지 않는다

# 판단 근거를 stderr에 한 줄 출력한다. stdout은 초안 JSON만 쓴다.
note() {
  echo "detect: $*" >&2
}

# 사용자가 확인해야 할 문제를 stderr에 한 줄 출력한다.
warn() {
  echo "detect: 경고: $*" >&2
}

# 디렉터리에서 glob 패턴에 맞는 첫 항목의 이름을 출력한다. 없으면 아무것도 출력하지 않는다.
#   $1 찾을 디렉터리, $2 glob 패턴. 출력은 그 디렉터리 기준 상대 경로다.
#   예: first_match "$project_dir" '*.xcworkspace' → MotoTrace.xcworkspace
first_match() {
  local search_dir="$1"
  local pattern="$2"
  (
    cd "$search_dir"
    for entry in $pattern; do   # 따옴표 없이 써야 glob이 펼쳐진다
      if [ -e "$entry" ]; then
        echo "$entry"
        break
      fi
    done
  ) || true
}

# 루트 Makefile에 타깃이 있으면 성공(0), 없으면 실패(1)
#   $1 타깃 이름
#   예: Makefile에 "generate:" 줄이 있으면 makefile_has_target generate → 성공
makefile_has_target() {
  local target="$1"
  [ -f "$project_dir/Makefile" ] && grep -qE "^$target[[:space:]]*:" "$project_dir/Makefile"
}

# 파일에서 정규식에 맞는 첫 부분을 찾아, 그 안의 따옴표 값을 출력한다. 없으면 아무것도 출력하지 않는다.
#   $1 파일, $2 정규식(ERE)
#   예: Workspace.swift의 '    name: "MotoTrace",' → MotoTrace
first_quoted_value() {
  local file="$1"
  local pattern="$2"
  local matched=""   # 정규식에 맞은 부분 (예: ' name: "MotoTrace"')

  if ! matched="$(grep -m1 -oE "$pattern" "$file" 2>/dev/null)"; then
    return 0
  fi

  printf '%s\n' "$matched" \
    | sed -E 's/^[^"]*"([^"]*)".*/\1/' \
    | head -n 1 \
    || return 0
}

# Tuist 프로젝트면 성공(0)
#   Tuist 설정 파일(Tuist.swift, Tuist/Config.swift)이 있거나,
#   Tuist/ 폴더와 manifest(Workspace.swift, Project.swift)가 함께 있으면 Tuist 프로젝트로 본다.
is_tuist_project() {
  if [ -f "$project_dir/Tuist.swift" ] || [ -f "$project_dir/Tuist/Config.swift" ]; then
    return 0
  fi
  [ -d "$project_dir/Tuist" ] \
    && { [ -f "$project_dir/Workspace.swift" ] || [ -f "$project_dir/Project.swift" ]; }
}

# 스킴 목록(schemes_json)에 그 이름이 있으면 성공(0). 스킴 목록은 아래 "스킴 목록" 섹션에서 채운다.
#   $1 스킴 이름
has_scheme() {
  local scheme="$1"
  printf '%s' "$schemes_json" | jq -e --arg scheme "$scheme" 'index($scheme) != null' > /dev/null
}

# --- 생성기 -------------------------------------------------------------------
# 결과: generator

generator=""   # 프로젝트를 만드는 방식: tuist · xcodegen · xcodeproj · spm
if is_tuist_project; then
  generator="tuist"
elif [ -f "$project_dir/project.yml" ] && grep -qE '^targets:' "$project_dir/project.yml"; then
  generator="xcodegen"
elif [ -n "$(first_match "$project_dir" '*.xcworkspace')" ] \
  || [ -n "$(first_match "$project_dir" '*.xcodeproj')" ]; then
  generator="xcodeproj"
elif [ -f "$project_dir/Package.swift" ]; then
  generator="spm"
else
  echo "detect: iOS 프로젝트를 찾지 못했습니다 (Tuist·XcodeGen·xcodeproj·Package.swift 없음): $project_dir" >&2
  exit 1
fi
note "생성기: $generator"

# --- 명령 ---------------------------------------------------------------------
# 결과: commands.install, commands.generate
# 프로젝트가 Makefile로 감싼 명령이 있으면 그것을 쓴다. 환경 변수 같은 프로젝트 고유 설정이 들어 있을 수 있다.

install_cmd=""    # 외부 의존성을 받는 명령 (예: make install, tuist install). 없으면 빈 문자열
generate_cmd=""   # .xcodeproj·.xcworkspace를 만드는 명령 (예: make generate, tuist generate). 없으면 빈 문자열
case "$generator" in
  tuist)
    if makefile_has_target generate; then
      generate_cmd="make generate"
    else
      generate_cmd="tuist generate"
    fi

    if makefile_has_target install; then
      install_cmd="make install"
    elif [ -f "$project_dir/Tuist/Package.swift" ]; then
      install_cmd="tuist install"
    fi
    ;;
  xcodegen)
    if makefile_has_target generate; then
      generate_cmd="make generate"
    else
      generate_cmd="xcodegen generate"
    fi
    ;;
esac

if [ -n "$generate_cmd" ]; then
  note "generate: $generate_cmd"
fi
if [ -n "$install_cmd" ]; then
  note "install: $install_cmd"
fi

# --- 빌드 대상 (workspace / project) -----------------------------------------
# 결과: workspace, project
# 중간값: container, container_flag, container_exists. 스킴 목록과 번들 ID를 xcodebuild에 물을 때 쓴다.

workspace=""   # 워크스페이스 파일 이름, 루트 기준 (예: MotoTrace.xcworkspace)
project=""     # 프로젝트 파일 이름, 루트 기준 (예: Sample.xcodeproj). 워크스페이스가 없을 때만 채운다
case "$generator" in
  tuist)
    # Swift 인자 name: "..."를 찾는다. 앞 글자는 줄 시작, "(", ",", 공백만 허용한다.
    # 그래야 _name:, ㅁname: 같은 다른 이름의 인자는 걸리지 않는다.
    name_pattern='(^|[(,[:space:]])name:[[:space:]]*"[^"]+"'
    workspace_name=""   # 워크스페이스 이름, 확장자 제외 (예: MotoTrace)

    # Workspace.swift의 name, 없으면 Project.swift의 name을 쓴다.
    if [ -f "$project_dir/Workspace.swift" ]; then
      workspace_name="$(first_quoted_value "$project_dir/Workspace.swift" "$name_pattern")"
    fi
    if [ -z "$workspace_name" ] && [ -f "$project_dir/Project.swift" ]; then
      workspace_name="$(first_quoted_value "$project_dir/Project.swift" "$name_pattern")"
    fi

    if [ -n "$workspace_name" ]; then
      workspace="$workspace_name.xcworkspace"
    else
      workspace="$(first_match "$project_dir" '*.xcworkspace')"
    fi
    ;;
  xcodegen)
    # project.yml의 최상위 name: 값이 프로젝트 이름이다 (예: name: Sample → Sample)
    xcodegen_project_name="$(
      { grep -m1 -E '^name:' "$project_dir/project.yml" || true; } \
        | sed -E 's/^name:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/'
    )"
    if [ -n "$xcodegen_project_name" ]; then
      project="$xcodegen_project_name.xcodeproj"
    fi
    ;;
  xcodeproj)
    workspace="$(first_match "$project_dir" '*.xcworkspace')"
    if [ -z "$workspace" ]; then
      project="$(first_match "$project_dir" '*.xcodeproj')"
    fi
    ;;
  spm)
    warn "SPM 패키지는 아직 build·test 스크립트가 지원하지 않습니다"
    ;;
esac

container=""        # xcodebuild에 넘길 빌드 대상 파일 이름. workspace가 있으면 workspace, 없으면 project 값
container_flag=""   # 빌드 대상에 맞는 xcodebuild 옵션: -workspace 또는 -project
if [ -n "$workspace" ]; then
  container="$workspace"
  container_flag="-workspace"
elif [ -n "$project" ]; then
  container="$project"
  container_flag="-project"
fi

if [ -n "$container" ]; then
  note "빌드 대상: $container"
fi
if [ -z "$container" ] && [ "$generator" != "spm" ]; then
  warn "빌드 대상(workspace/project)을 정하지 못했습니다. 직접 채우세요"
fi

container_exists=0   # 빌드 대상 파일이 실제로 있으면 1. Tuist·XcodeGen은 generate 전에는 0이다
if [ -n "$container" ] && [ -e "$project_dir/$container" ]; then
  container_exists=1
fi
if [ "$container_exists" = 0 ] && [ -n "$generate_cmd" ]; then
  warn "$container 가 아직 생성되지 않았습니다." \
    "'$generate_cmd' 실행 뒤 다시 detect하면 스킴과 번들 ID를 확인합니다"
fi

# --- 앱 찾기 ----------------------------------------------------------------
# 결과: app.path
# 중간값: targets_json, app_target. 앱 스킴, 번들 ID, 단위 테스트 타깃이 쓴다.

app_path=""           # 앱 manifest(Project.swift)가 있는 디렉터리, 루트 기준 (예: MotoTrace). Tuist만 채운다
app_project_name=""   # 앱 .xcodeproj 이름에서 확장자를 뺀 것 (예: MotoTrace)
app_xcodeproj_dir=""  # 앱 타깃을 읽을 .xcodeproj 절대 경로 (예: <루트>/MotoTrace/MotoTrace.xcodeproj)
case "$generator" in
  tuist)
    # product: .app이 있는 Project.swift를 찾는다. 생성물·의존성 폴더는 뺀다.
    # 결과: 한 줄에 하나, 루트 기준 경로 (예: MotoTrace/Project.swift)
    app_manifests="$(
      cd "$project_dir" \
        && { grep -rlE 'product:[[:space:]]*\.app([^A-Za-z]|$)' --include='Project.swift' . 2> /dev/null || true; } \
        | { grep -vE '/(Derived|\.build|Tuist)/' || true; } \
        | sed 's|^\./||' \
        | sort
    )"

    if [ -z "$app_manifests" ]; then
      warn "앱 manifest(product: .app)를 찾지 못했습니다. app 값을 직접 채우세요"
    else
      app_manifest="$(printf '%s\n' "$app_manifests" | head -n 1)"                     # 그중 첫 번째
      app_manifest_count="$(printf '%s\n' "$app_manifests" | wc -l | tr -d ' ')"
      if [ "$app_manifest_count" -gt 1 ]; then
        warn "앱 manifest가 여러 개입니다. 첫 번째($app_manifest)를 골랐습니다:" \
          "$(printf '%s ' $app_manifests)"
      fi

      app_path="$(dirname "$app_manifest")"
      app_xcodeproj="$(first_match "$project_dir/$app_path" '*.xcodeproj')"   # 생성된 앱 프로젝트 (예: MotoTrace.xcodeproj)
      if [ -n "$app_xcodeproj" ]; then
        app_project_name="${app_xcodeproj%.xcodeproj}"
        app_xcodeproj_dir="$project_dir/$app_path/$app_xcodeproj"
      else
        # 아직 생성 전이면 디렉터리 이름으로 추정한다.
        app_project_name="$(basename "$project_dir/$app_path")"
      fi
    fi
    ;;
  xcodegen | xcodeproj)
    # 루트의 앱 프로젝트 (예: Sample.xcodeproj)
    if [ -n "$project" ]; then
      app_xcodeproj="$project"
    else
      app_xcodeproj="$(first_match "$project_dir" '*.xcodeproj')"
    fi

    if [ -n "$app_xcodeproj" ]; then
      app_project_name="${app_xcodeproj%.xcodeproj}"
      app_xcodeproj_dir="$project_dir/$app_xcodeproj"
    fi
    ;;
esac

# 앱 프로젝트의 타깃 목록을 한 번만 읽어 둔다. 프로젝트 파일은 형식이 두 가지이고, 둘 다 plutil로 JSON 변환한다.
#
# project.pbxproj (기존 형식). objects는 ID → 객체 사전이고, 타깃은 설정 목록 ID를, 설정 목록은 설정 ID들을 가리킨다.
#   {"objects": {
#     "T1": {"isa":"PBXNativeTarget", "name":"MotoTrace", "buildConfigurationList":"L1",
#            "productType":"com.apple.product-type.application"},
#     "L1": {"isa":"XCConfigurationList", "buildConfigurations":["C1","C2"]},
#     "C1": {"isa":"XCBuildConfiguration", "name":"Debug",
#            "buildSettings":{"PRODUCT_BUNDLE_IDENTIFIER":"com.woong.MotoTrace"}}
#   }}
#
# project.xcproj (Xcode 27의 새 형식, 끝 쉼표가 있는 JSON). 종류는 com.apple.product-type. 접두 없이 쓰고,
# 구성별 값은 설정 이름 뒤에 [config=Debug]를 붙인다.
#   {"targets": [
#     {"name":"WorkoutRest", "product-type":"application",
#      "build-settings":{"PRODUCT_BUNDLE_IDENTIFIER":"com.woong.WorkoutRest"}}
#   ]}
#
# targets_json: 타깃마다 이름·종류·Debug 번들 ID를 뽑은 배열. 프로젝트 파일이 없거나 못 읽으면 빈 문자열
#   [{"name":"MotoTrace", "type":"com.apple.product-type.application", "bundleId":"com.woong.MotoTrace"},
#    {"name":"MotoTraceTests", "type":"com.apple.product-type.bundle.unit-test", "bundleId":"com.woong.MotoTraceTests"}]
targets_json=""
project_file=""   # 타깃을 읽은 프로젝트 파일 이름: project.pbxproj 또는 project.xcproj
if [ -n "$app_xcodeproj_dir" ] && [ -f "$app_xcodeproj_dir/project.pbxproj" ]; then
  project_file="project.pbxproj"
  targets_json="$(
    plutil -convert json -o - "$app_xcodeproj_dir/$project_file" 2> /dev/null \
      | jq -c '
        .objects as $objects
        | [ $objects[]
            | select(.isa == "PBXNativeTarget")
            | {
                name,
                type: .productType,
                bundleId: (
                  [ $objects[.buildConfigurationList].buildConfigurations[]?
                    | $objects[.]
                    | select(.name == "Debug")
                    | .buildSettings.PRODUCT_BUNDLE_IDENTIFIER ]
                  | first
                )
              }
          ]' 2> /dev/null \
      || true
  )"
elif [ -n "$app_xcodeproj_dir" ] && [ -f "$app_xcodeproj_dir/project.xcproj" ]; then
  project_file="project.xcproj"
  targets_json="$(
    plutil -convert json -o - "$app_xcodeproj_dir/$project_file" 2> /dev/null \
      | jq -c '
        [ .targets[]?
          | (."build-settings" // {}) as $settings
          | {
              name,
              type: (."product-type" // "" | if startswith("com.apple.") then . else "com.apple.product-type." + . end),
              bundleId: ($settings["PRODUCT_BUNDLE_IDENTIFIER[config=Debug]"] // $settings.PRODUCT_BUNDLE_IDENTIFIER)
            }
        ]' 2> /dev/null \
      || true
  )"
elif [ -n "$app_xcodeproj_dir" ] && [ -d "$app_xcodeproj_dir" ]; then
  warn "${app_xcodeproj_dir#$project_dir/}에 project.pbxproj도 project.xcproj도 없습니다." \
    "앱 스킴, 번들 ID, 단위 테스트 타깃을 직접 채우세요"
fi
if [ -n "$project_file" ] && [ -z "$targets_json" ]; then
  warn "프로젝트 파일을 읽지 못했습니다: ${app_xcodeproj_dir#$project_dir/}/$project_file"
fi

# 앱 타깃이 여러 개면 프로젝트 이름과 같은 것을 먼저 고른다.
app_target=""   # 앱 타깃 이름 (예: MotoTrace)
if [ -n "$targets_json" ]; then
  app_target="$(
    printf '%s' "$targets_json" | jq -r --arg preferred_name "$app_project_name" '
      [ .[] | select(.type == "com.apple.product-type.application") ]
      | ((map(select(.name == $preferred_name)) + .) | first | .name) // empty'
  )"
fi

# --- 스킴 목록 (중간값) --------------------------------------------------------
# 생성된 빌드 대상이 있고 온라인일 때만 xcodebuild -list로 확인한다.
# 앱 스킴을 고를 때와 모듈 스킴 규칙을 대조할 때 쓴다.

schemes_json="[]"   # 빌드 대상에 있는 스킴 이름 배열 (예: ["CoreTracking","MotoTrace"])
schemes_known=0     # 스킴 목록을 실제로 확인했으면 1. 0이면 스킴 이름을 추정만 하고 대조하지 않는다
if [ "$offline" != 1 ] && [ "$container_exists" = 1 ]; then
  # xcodebuild -list -json 출력 예. project일 때는 "workspace" 자리에 "project"가 온다.
  #   {"workspace":{"name":"MotoTrace","schemes":["CoreTracking","MotoTrace"]}}
  if xcodebuild_list_json="$(
    cd "$project_dir" && xcodebuild -list -json "$container_flag" "$container" 2> /dev/null
  )"; then
    schemes_json="$(
      printf '%s' "$xcodebuild_list_json" \
        | jq -c '(.workspace.schemes // .project.schemes // [])'
    )"
    scheme_count="$(printf '%s' "$schemes_json" | jq length)"

    if [ "$scheme_count" -gt 0 ]; then
      schemes_known=1
      note "스킴 ${scheme_count}개 확인 (xcodebuild -list)"
    else
      # 빈 목록을 그대로 믿으면 앱·모듈 스킴이 모두 "없다"고 판단한다. 확인하지 못한 것으로 처리한다.
      schemes_json="[]"
      warn "xcodebuild -list가 스킴을 하나도 돌려주지 않았습니다 — 스킴을 확인하지 못했습니다"
    fi
  else
    warn "xcodebuild -list 실패 — 스킴을 확인하지 못했습니다"
  fi
fi

# --- 앱 스킴 ----------------------------------------------------------------
# 결과: app.scheme
# 앱 타깃 이름 → 프로젝트 이름 순으로, 스킴 목록에 있는 것을 고른다.
# 스킴 목록을 확인하지 못했으면(schemes_known=0) 첫 후보를 그대로 쓴다.

app_scheme=""   # 앱을 빌드할 스킴 이름 (예: MotoTrace)
for candidate in "$app_target" "$app_project_name"; do
  if [ -z "$candidate" ]; then
    continue
  fi
  if [ "$schemes_known" = 0 ] || has_scheme "$candidate"; then
    app_scheme="$candidate"
    break
  fi
done

if [ -z "$app_scheme" ]; then
  warn "앱 스킴을 정하지 못했습니다. app.scheme을 직접 채우세요"
elif [ "$schemes_known" = 0 ]; then
  warn "스킴 목록을 확인하지 못해 앱 스킴을 추정했습니다: $app_scheme"
else
  note "앱 스킴: $app_scheme"
fi

# --- 번들 ID ----------------------------------------------------------------
# 결과: app.bundleId
# 프로젝트 파일의 앱 타깃 값을 먼저 쓴다. $(VAR)처럼 빌드 설정 변수면 앱 스킴으로 xcodebuild에 실제 값을 묻는다.

bundle_id=""              # 앱 번들 ID (예: com.woong.MotoTrace)
bundle_id_unresolved=""   # 확인하지 못한 원래 값 (예: $(APP_BUNDLE_ID)). 경고에 보여 준다
if [ -n "$targets_json" ]; then
  bundle_id="$(
    printf '%s' "$targets_json" | jq -r --arg target "$app_target" '
      .[] | select(.name == $target) | .bundleId // empty'
  )"
fi

case "$bundle_id" in
  *'$('*)
    bundle_id_unresolved="$bundle_id"
    bundle_id=""
    ;;
esac

if [ -z "$bundle_id" ] && [ -n "$app_scheme" ] && [ "$offline" != 1 ] && [ "$container_exists" = 1 ]; then
  # xcodebuild -showBuildSettings -json 출력 예: 스킴에 든 타깃마다 하나씩
  #   [{"target":"MotoTrace", "buildSettings":{"WRAPPER_EXTENSION":"app", "PRODUCT_BUNDLE_IDENTIFIER":"com.woong.MotoTrace"}},
  #    {"target":"CoreTracking", "buildSettings":{"WRAPPER_EXTENSION":"framework", ...}}]
  bundle_id="$(
    cd "$project_dir" \
      && xcodebuild -showBuildSettings -json "$container_flag" "$container" -scheme "$app_scheme" 2> /dev/null \
      | jq -r '
        [ .[] | select(.buildSettings.WRAPPER_EXTENSION == "app") ][0]
        | .buildSettings.PRODUCT_BUNDLE_IDENTIFIER // empty' 2> /dev/null \
      || true
  )"
  if [ -n "$bundle_id" ]; then
    note "번들 ID: $bundle_id (xcodebuild -showBuildSettings)"
  fi
elif [ -n "$bundle_id" ]; then
  note "번들 ID: $bundle_id ($project_file)"
fi

if [ -z "$bundle_id" ]; then
  warn "번들 ID를 확인하지 못했습니다${bundle_id_unresolved:+ ($bundle_id_unresolved)}." \
    "app.bundleId를 직접 채우세요"
fi

# --- 단위 테스트 타깃 ----------------------------------------------------------
# 결과: app.unitTestTargets
# 앱 프로젝트의 단위 테스트 타깃만 고른다. UI 테스트 타깃은 뺀다.

unit_tests_json="[]"   # 단위 테스트 타깃 이름 배열 (예: ["MotoTraceTests"])
if [ -n "$targets_json" ]; then
  unit_tests_json="$(
    printf '%s' "$targets_json" | jq -c '
      [ .[] | select(.type == "com.apple.product-type.bundle.unit-test") | .name ]'
  )"
fi

# 출력용 문자열 (예: "MotoTraceTests", 없으면 "없음")
unit_test_names="$(
  printf '%s' "$unit_tests_json" \
    | jq -r 'if length == 0 then "없음" else join(", ") end'
)"
note "앱 단위 테스트 타깃: $unit_test_names"

# --- 모듈 (Tuist) -----------------------------------------------------------
# 결과: modules
# Project.swift가 있는 디렉터리를 모듈 하나로 본다. 앱 디렉터리와 루트는 제외한다.

modules_json="null"   # 모듈 규칙 객체. 모듈이 없으면 null
if [ "$generator" = "tuist" ]; then
  # 모듈 디렉터리 목록. 한 줄에 하나, 루트 기준 (예: Modules/Core/CoreTracking)
  module_dirs="$(
    cd "$project_dir" \
      && find . -name Project.swift \
        -not -path '*/Derived/*' \
        -not -path '*/.build/*' \
        -not -path './Tuist/*' 2> /dev/null \
      | sed -e 's|^\./||' -e 's|/Project.swift$||' \
      | { grep -vxE "Project.swift|${app_path:-.}" || true; } \
      | sort \
      || true
  )"

  if [ -n "$module_dirs" ]; then
    # manifest: 모듈을 알아보는 파일, scheme: 스킴 이름 규칙({dir} = 디렉터리 이름), testsDir: 테스트 폴더 이름
    modules_json='{"manifest":"Project.swift","scheme":"{dir}","testsDir":"Tests"}'

    # 진단: 아래 반복문은 모듈 수, 테스트 있는 모듈 수, 스킴 규칙 대조 결과를 안내하기만 한다.
    # modules_json에는 영향이 없다.
    module_count=0              # 찾은 모듈 수
    modules_with_tests=0        # 그중 테스트가 있는 모듈 수
    # 디렉터리 이름과 같은 스킴이 없는 모듈 디렉터리. ", "로 구분 (예: Modules/Core/CoreB, Modules/Feature/FeatureA)
    modules_without_scheme=""

    while IFS= read -r module_dir; do
      module_count=$((module_count + 1))
      module_name="$(basename "$module_dir")"   # 예: CoreTracking

      # 생성된 공유 스킴 파일. 모듈 디렉터리 기준
      # (예: CoreTracking.xcodeproj/xcshareddata/xcschemes/CoreTracking.xcscheme)
      scheme_file="$(first_match "$project_dir/$module_dir" "*.xcodeproj/xcshareddata/xcschemes/$module_name.xcscheme")"

      # 스킴 파일이 있으면 테스트 대상이 들어 있는지 보고, 없으면 Tests 폴더로 판단한다.
      if [ -n "$scheme_file" ]; then
        if grep -q '<TestableReference' "$project_dir/$module_dir/$scheme_file"; then
          modules_with_tests=$((modules_with_tests + 1))
        fi
      elif [ -d "$project_dir/$module_dir/Tests" ]; then
        modules_with_tests=$((modules_with_tests + 1))
      fi

      if [ "$schemes_known" = 1 ] && ! has_scheme "$module_name"; then
        # 두 번째 모듈부터는 앞에 구분자를 붙인다.
        if [ -n "$modules_without_scheme" ]; then
          modules_without_scheme="$modules_without_scheme, "
        fi
        modules_without_scheme="$modules_without_scheme$module_dir"
      fi
    done <<< "$module_dirs"

    note "모듈 ${module_count}개 (테스트 있는 모듈 ${modules_with_tests}개, 기준: Project.swift)"
    if [ -n "$modules_without_scheme" ]; then
      warn "디렉터리 이름과 같은 스킴이 없는 모듈: $modules_without_scheme" \
        "— modules.scheme 규칙을 확인하세요"
    elif [ "$schemes_known" = 1 ]; then
      note "모듈 스킴 규칙 {dir}: ${module_count}개 모두 일치"
    fi
  fi
fi

# --- 모듈 (SPM 로컬 패키지) -----------------------------------------------------
# 결과: modules
# xcodeproj·XcodeGen 앱의 하위 폴더에 Package.swift가 있으면 그 폴더를 모듈 하나로 본다 (예: Packages/).
# 스킴은 적지 않는다(null). 패키지 스킴 이름은 제품·타깃 수에 따라 "<패키지 이름>-Package"이거나 패키지 이름이라,
# build·test가 실행할 때 패키지 폴더의 스킴 목록에서 고른다. 그래서 패키지가 여럿이어도 규칙 하나로 된다.

if [ "$generator" = "xcodeproj" ] || [ "$generator" = "xcodegen" ]; then
  # 패키지 폴더 목록. 한 줄에 하나, 루트 기준 (예: Packages). 의존성 체크아웃·빌드 폴더는 뺀다.
  package_dirs="$(
    cd "$project_dir" \
      && find . -mindepth 2 -name Package.swift \
        -not -path '*/.build/*' \
        -not -path '*/.swiftpm/*' \
        -not -path '*/SourcePackages/*' \
        -not -path '*/Derived/*' \
        -not -path './.harness/*' 2> /dev/null \
      | sed -e 's|^\./||' -e 's|/Package.swift$||' \
      | sort \
      || true
  )"
  if [ -n "$package_dirs" ]; then
    modules_json='{"manifest":"Package.swift","scheme":null,"testsDir":"Tests"}'
    note "모듈: SPM 로컬 패키지 $(printf '%s\n' "$package_dirs" | wc -l | tr -d ' ')개 ($(printf '%s\n' "$package_dirs" | paste -sd ',' - | sed 's/,/, /g'))." \
      "스킴은 build·test가 패키지 폴더에서 고릅니다"
  fi
fi

# --- 매크로 패키지 ---------------------------------------------------------------
# swift-syntax를 받는 프로젝트는 매크로 패키지(TCA 등)를 쓴다. CLI 빌드는 Xcode에서 매크로 신뢰를 확인받기 전에는 막힌다.
# 확인을 건너뛰는 skipMacroValidation은 패키지 코드를 믿을지 정하는 일이라 detect가 켜지 않고 알리기만 한다.
resolved_with_macros="$(
  cd "$project_dir" \
    && find . -name Package.resolved \
      -not -path '*/.build/*' \
      -not -path '*/SourcePackages/*' \
      -not -path '*/Derived/*' 2> /dev/null \
    | while IFS= read -r resolved; do
        if grep -q 'swift-syntax' "$resolved"; then printf '%s\n' "${resolved#./}"; fi
      done \
    | head -n 1 \
    || true
)"
if [ -n "$resolved_with_macros" ]; then
  note "매크로 패키지를 씁니다 ($resolved_with_macros에 swift-syntax)." \
    "빌드가 'Macro … must be enabled'로 막히면 사람이 확인한 뒤 skipMacroValidation을 true로 바꾸세요"
fi

# --- 시뮬레이터 -------------------------------------------------------------
# 결과: destination.simulator
# 가장 최신 iOS 런타임의 iPhone 중 번호가 가장 큰 Pro 모델, 없으면 첫 iPhone을 고른다.

simulator="${HARNESS_SIMULATOR:-}"   # 시뮬레이터 기기 이름 (예: iPhone 17 Pro)
if [ -z "$simulator" ] && [ "$offline" != 1 ]; then
  # xcrun simctl list devices available -j 출력 예: 런타임 키마다 기기 배열
  #   {"devices": {
  #     "com.apple.CoreSimulator.SimRuntime.iOS-26-0": [{"name":"iPhone 17 Pro", "udid":"3422B9FD-...", ...}, ...],
  #     "com.apple.CoreSimulator.SimRuntime.watchOS-26-0": [...]
  #   }}
  simulator="$(
    xcrun simctl list devices available -j 2> /dev/null \
      | jq -r '
        [ .devices
          | to_entries[]
          | select(.key | test("SimRuntime\\.iOS-[0-9]+-[0-9]+"))
          | {
              version: (
                .key
                | capture("iOS-(?<major>[0-9]+)-(?<minor>[0-9]+)")
                | [(.major | tonumber), (.minor | tonumber)]
              ),
              iphones: [ .value[] | select(.name | startswith("iPhone")) | .name ]
            }
          | select(.iphones | length > 0)
        ]
        | sort_by(.version)
        | last
        | .iphones // []
        | (
            map(select(test("^iPhone [0-9]+ Pro$")))
            | sort_by(capture("(?<number>[0-9]+)").number | tonumber)
            | last
          ) // .[0] // empty' 2> /dev/null \
      || true
  )"
fi

if [ -n "$simulator" ]; then
  note "시뮬레이터: $simulator"
else
  warn "시뮬레이터를 정하지 못했습니다. destination.simulator를 직접 채우세요"
fi

# --- 출력 -------------------------------------------------------------------

# 설정 파일 초안. 각 값의 뜻은 docs/project-config.md에 있다.
draft_json="$(
  jq -n \
    --arg generator "$generator" \
    --arg install "$install_cmd" \
    --arg generate "$generate_cmd" \
    --arg workspace "$workspace" \
    --arg project "$project" \
    --arg appScheme "$app_scheme" \
    --arg appPath "$app_path" \
    --arg bundleId "$bundle_id" \
    --argjson unitTests "$unit_tests_json" \
    --arg simulator "$simulator" \
    --argjson modules "$modules_json" '
    # 빈 문자열은 "값 없음"이라 null로 바꾼다.
    def orNull: if . == "" then null else . end;

    {
      schemaVersion: 1,
      generator: $generator,
      commands: {
        install: ($install | orNull),
        generate: ($generate | orNull)
      },
      workspace: ($workspace | orNull),
      project: ($project | orNull),
      app: {
        scheme: ($appScheme | orNull),
        path: ($appPath | orNull),
        bundleId: ($bundleId | orNull),
        unitTestTargets: $unitTests
      },
      destination: {
        simulator: ($simulator | orNull),
        os: "latest"
      },
      modules: $modules,
      skipMacroValidation: false
    }'
)"

if [ "$write_to_file" = 1 ]; then
  config_file="$project_dir/.harness/project.json"
  if [ -e "$config_file" ] && [ "$overwrite_existing" != 1 ]; then
    echo "detect: $config_file 이 이미 있습니다. 덮어쓰려면 --force를 붙이세요" >&2
    exit 1
  fi
  mkdir -p "$project_dir/.harness"
  printf '%s\n' "$draft_json" > "$config_file"
  note "저장했습니다: $config_file"
else
  printf '%s\n' "$draft_json"
  note "초안입니다. 값을 확인한 뒤 --write로 저장하세요"
fi
