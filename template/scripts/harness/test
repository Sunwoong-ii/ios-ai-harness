#!/usr/bin/env bash
# 단위 테스트를 시뮬레이터에서 실행하고 결과를 요약한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/test [--scheme 스킴] [--package 폴더] [--only 대상]... [--generate]

  기본: 앱 스킴으로 app.unitTestTargets의 테스트만 실행한다 (UI 테스트 제외).
  성공하면 한 줄, 실패하면 실패한 테스트와 메시지를 출력한다.

  --scheme 스킴   이 스킴의 테스트 액션을 실행한다 (모듈 스킴 등)
  --package 폴더  앱 프로젝트 대신 이 폴더의 Package.swift로 실행한다. --scheme이 필요하다
                  (보통 <패키지 이름>-Package). 앱에 아직 연결하지 않은 로컬 패키지도 테스트할 수 있다
  --only 대상      -only-testing 대상: 타깃, 타깃/클래스, 타깃/클래스/메서드. 여러 번 쓸 수 있다
  --generate      변경이 없어도 프로젝트를 다시 생성한다 (Tuist·XcodeGen)

산출물 (.harness/out/): test-<스킴>.log(원본 로그), test-<스킴>.xcresult(결과 번들)
EOF
}

scheme=""
package_dir=""
only=""
force_generate=""
while [ $# -gt 0 ]; do
  case "$1" in
    --scheme) [ $# -ge 2 ] || harness_die "--scheme에 스킴 이름이 필요합니다"; scheme="$2"; shift ;;
    --package) [ $# -ge 2 ] || harness_die "--package에 패키지 폴더가 필요합니다"; package_dir="$2"; shift ;;
    --only) [ $# -ge 2 ] || harness_die "--only에 대상이 필요합니다"; only="$only$2"$'\n'; shift ;;
    --generate) force_generate=force ;;
    -h|--help) usage; exit 0 ;;
    *) echo "test: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

harness_init
harness_destination
harness_extra_args
run_dir="$root"   # xcodebuild를 실행할 폴더
if [ -n "$package_dir" ]; then
  [ -n "$scheme" ] || harness_die "--package에는 --scheme이 필요합니다 (패키지 폴더에서 xcodebuild -list로 확인)"
  # 상대 경로는 프로젝트 루트 기준이다.
  case "$package_dir" in /*) ;; *) package_dir="$root/$package_dir" ;; esac
  [ -f "$package_dir/Package.swift" ] || harness_die "Package.swift가 없습니다: $package_dir"
  package_dir="$(cd "$package_dir" && pwd)"
  # 패키지 폴더에서 -project/-workspace 없이 실행하면 xcodebuild가 Package.swift를 읽는다.
  run_dir="$package_dir"
  container_args=()
  # 앱 프로젝트와 패키지는 서로 다른 워크스페이스다. 같은 빌드 폴더를 번갈아 쓰지 않게 패키지마다 따로 둔다.
  # 예: <앱 DerivedData>-Packages, 루트의 패키지면 <앱 DerivedData>-package
  package_rel="${package_dir#"$root"}"
  package_rel="${package_rel#/}"
  package_rel="${package_rel//\//-}"
  derived_data="$derived_data-${package_rel:-package}"
else
  harness_container_args
fi
if [ -z "$scheme" ]; then
  scheme="$(cfg .app.scheme)"
  [ -n "$scheme" ] || harness_die "설정에 app.scheme이 없습니다"
  if [ -z "$only" ]; then
    only="$(jq -r '.app.unitTestTargets // [] | .[]' "$config")"
    if [ -z "$only" ]; then
      echo "· test $scheme · 실행할 테스트 없음 (app.unitTestTargets가 비어 있음)"
      exit 0
    fi
  fi
fi

only_args=()
while IFS= read -r target; do
  if [ -n "$target" ]; then only_args+=("-only-testing:$target"); fi
done <<EOF
$only
EOF

start=$SECONDS
generated_now=0
# 패키지는 생성 대상이 아니다.
if [ -z "$package_dir" ]; then harness_ensure_generated "$force_generate" || exit 1; fi

# 스킴마다 따로 남긴다. verify가 여러 스킴을 연달아 테스트해도 앞서 실패한 스킴의 로그가 덮어써지지 않는다.
log="$out_dir/test-$scheme.log"
result="$out_dir/test-$scheme.xcresult"
rm -rf "$result"

set +e
# bash 3.2는 빈 배열을 "${arr[@]}"로 펼치면 오류가 나서 ${arr[@]+...} 형태로 쓴다.
(cd "$run_dir" && xcodebuild test ${container_args[@]+"${container_args[@]}"} \
  -scheme "$scheme" \
  -destination "$destination" \
  -derivedDataPath "$derived_data" \
  -resultBundlePath "$result" \
  -quiet ${extra_args[@]+"${extra_args[@]}"} ${only_args[@]+"${only_args[@]}"}) > "$log" 2>&1
code=$?
set -e
elapsed=$((SECONDS - start))

summary="$(harness_test_summary "$result")"
total=0
failed=0
skipped=0
if [ -n "$summary" ]; then
  total="$(printf '%s' "$summary" | jq '.totalTestCount // 0')"
  failed="$(printf '%s' "$summary" | jq '.failedTests // 0')"
  skipped="$(printf '%s' "$summary" | jq '.skippedTests // 0')"
fi
note=""
if [ "$generated_now" = 1 ]; then note=" (generate 포함)"; fi
skip_note=""
if [ "$skipped" -gt 0 ]; then skip_note=" · 건너뜀 $skipped"; fi

if [ "$code" -eq 0 ]; then
  if [ "$total" -eq 0 ]; then
    echo "✓ test $scheme · 실행된 테스트 없음 · ${elapsed}s$note"
  else
    echo "✓ test $scheme · 통과 $((total - skipped))$skip_note · ${elapsed}s$note"
  fi
  exit 0
fi

if [ "$failed" -gt 0 ]; then
  echo "✗ test $scheme 실패 · 실패 $failed / 전체 $total · ${elapsed}s$note"
  harness_print_test_failures "$result" "$summary"
  if [ "$failed" -gt "$max_errors" ]; then echo "  … 실패 $((failed - max_errors))개 더 있음"; fi
else
  # 테스트가 돌기 전에 멈췄다(빌드 실패, 스킴에 테스트 액션 없음 등).
  json="$(harness_build_results "$result")"
  echo "✗ test $scheme 실패 · 테스트 실행 전 중단 (빌드 에러 $(build_count "$json" errorCount)) · ${elapsed}s$note"
  harness_print_build_errors "$json" "$log"
fi
harness_print_artifacts "$log" "$result"
exit "$code"
